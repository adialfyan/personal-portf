# Supabase — public (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key

# Supabase — server only, NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-key

# Public site URL (used for sitemap, robots, OG)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Cloudflare Turnstile (optional — contact form bot protection)
# Leave both empty to keep honeypot + rate-limit only.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x0000000000000000000000
# TURNSTILE_SECRET_KEY=0x0000000000000000000000000000000000000000
